<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F5">

    <!-- Fixed header -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:padding="12dp"
        android:text="Create your account"
        android:textColor="#1C2533"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Fixed signup button -->
    <Button
        android:id="@+id/signUp"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#F66A2A"
        android:text="Create Account"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/textView"
        app:layout_constraintBottom_toTopOf="@id/signUp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:text="Join MacroBite and personalize your meals."
                android:textColor="#697381"
                android:textSize="15sp"
                android:gravity="center"/>

            <!-- Account Details -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACCOUNT DETAILS"
                android:textColor="#F66A2A"
                android:textStyle="bold"
                android:textSize="14sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="14dp"/>

            <EditText
                android:id="@+id/username"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/mb_input"
                android:hint="Full name"
                android:inputType="textPersonName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1C2533"
                android:textColorHint="#8B919A"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/mb_input"
                android:hint="Email address"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1C2533"
                android:textColorHint="#8B919A"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/mb_input"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1C2533"
                android:textColorHint="#8B919A"
                android:textSize="16sp"/>

            <!-- Existing password validation indicators -->
            <TextView
                android:id="@+id/atLeast8CharTV"
                style="@style/Widget.AppCompat.TextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• At least 8 characters"
                android:textColor="#697381"
                android:textSize="13sp"
                android:paddingTop="12dp"/>

            <TextView
                android:id="@+id/letters3TV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• At least 3 letters"
                android:textColor="#697381"
                android:textSize="13sp"
                android:paddingTop="5dp"/>

            <TextView
                android:id="@+id/upperCaseTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• At least 1 uppercase letter"
                android:textColor="#697381"
                android:textSize="13sp"
                android:paddingTop="5dp"/>

            <TextView
                android:id="@+id/numerics3TV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Number requirement"
                android:textColor="#697381"
                android:textSize="13sp"
                android:paddingTop="5dp"/>

            <TextView
                android:id="@+id/specialCharTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• At least 1 special character"
                android:textColor="#697381"
                android:textSize="13sp"
                android:paddingTop="5dp"/>

            <!-- Nutrition Profile -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="14dp"
                android:text="YOUR NUTRITION PROFILE"
                android:textColor="#F66A2A"
                android:textStyle="bold"
                android:textSize="14sp"
                android:letterSpacing="0.08"/>

            <EditText
                android:id="@+id/userAge"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/mb_input"
                android:hint="Age (years)"
                android:inputType="number"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1C2533"
                android:textColorHint="#8B919A"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/userHeight"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/mb_input"
                android:hint="Height (cm)"
                android:inputType="numberDecimal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1C2533"
                android:textColorHint="#8B919A"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/userWeight"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/mb_input"
                android:hint="Weight (kg)"
                android:inputType="numberDecimal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1C2533"
                android:textColorHint="#8B919A"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <!-- New: Sex for calorie calculation -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sex used for calorie estimation"
                android:textColor="#1C2533"
                android:textSize="15sp"
                android:layout_marginBottom="6dp"/>

            <Spinner
                android:id="@+id/userSex"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/mb_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp"/>

            <!-- New: Activity Level -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Activity level"
                android:textColor="#1C2533"
                android:textSize="15sp"
                android:layout_marginBottom="6dp"/>

            <Spinner
                android:id="@+id/activityLevel"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/mb_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp"/>

            <!-- New: Weight Goal -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your goal"
                android:textColor="#1C2533"
                android:textSize="15sp"
                android:layout_marginBottom="6dp"/>

            <Spinner
                android:id="@+id/weightGoal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/mb_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="20dp"/>

            <!-- Calculated Calories -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="@drawable/mb_soft">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="YOUR DAILY CALORIE TARGET"
                    android:textColor="#C64A18"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/textDailyCalories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Not calculated yet"
                    android:textColor="#1C2533"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="An estimate based on your profile"
                    android:textColor="#697381"
                    android:textSize="12sp"
                    android:gravity="center"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="16dp"
                android:text="You can update your nutrition goals later in your profile."
                android:textColor="#697381"
                android:textSize="13sp"
                android:gravity="center"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
