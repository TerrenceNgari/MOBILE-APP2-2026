<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="13dp" android:orientation="vertical" android:background="@drawable/mb_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/textCartFoodEmoji" android:layout_width="72dp" android:layout_height="74dp"
            android:gravity="center" android:text="🌯" android:textSize="38sp"
            android:background="@drawable/mb_product" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingLeft="13dp" android:orientation="vertical">
            <TextView android:id="@+id/textCartItemName" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Chicken Wrap" android:textStyle="bold" android:textSize="16sp" android:textColor="#1C2533" />
            <TextView android:id="@+id/textCartItemInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:text="460 kcal / serving" android:textSize="12sp" android:textColor="#697381" />
            <TextView android:id="@+id/textCartItemPrice" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="$12.50" android:textStyle="bold" android:textSize="16sp" android:textColor="#E45E28" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/btnRemove" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"
            android:gravity="center_vertical" android:paddingLeft="4dp" android:text="Remove" android:textSize="13sp"
            android:textColor="#C95B42" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/btnMinus" android:layout_width="42dp" android:layout_height="42dp"
            android:gravity="center" android:text="−" android:textSize="23sp" android:textColor="#C64A18"
            android:background="@drawable/mb_soft" android:clickable="true" android:focusable="true"
            android:contentDescription="Decrease item quantity" />
        <TextView android:id="@+id/textCartQty" android:layout_width="44dp" android:layout_height="42dp"
            android:gravity="center" android:text="1" android:textSize="16sp" android:textStyle="bold" android:textColor="#1C2533" />
        <TextView android:id="@+id/btnPlus" android:layout_width="42dp" android:layout_height="42dp"
            android:gravity="center" android:text="+" android:textSize="23sp" android:textColor="#C64A18"
            android:background="@drawable/mb_soft" android:clickable="true" android:focusable="true"
            android:contentDescription="Increase item quantity" />
    </LinearLayout>
</LinearLayout>