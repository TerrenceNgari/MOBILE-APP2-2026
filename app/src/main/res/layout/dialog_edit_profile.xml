<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Name" android:textColor="#243040" android:textStyle="bold" android:textSize="13sp" />
        <EditText android:id="@+id/editName" android:layout_width="match_parent" android:layout_height="52dp"
            android:inputType="textPersonName" android:singleLine="true" android:hint="Full name" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Email" android:textColor="#243040" android:textStyle="bold" android:textSize="13sp" />
        <EditText android:id="@+id/editEmail" android:layout_width="match_parent" android:layout_height="52dp"
            android:inputType="textEmailAddress" android:singleLine="true" android:hint="Email address" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Height (cm)" android:textColor="#243040" android:textStyle="bold" android:textSize="13sp" />
        <EditText android:id="@+id/editHeight" android:layout_width="match_parent" android:layout_height="52dp"
            android:inputType="numberDecimal" android:singleLine="true" android:hint="Height in cm" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Weight (kg)" android:textColor="#243040" android:textStyle="bold" android:textSize="13sp" />
        <EditText android:id="@+id/editWeight" android:layout_width="match_parent" android:layout_height="52dp"
            android:inputType="numberDecimal" android:singleLine="true" android:hint="Weight in kg" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Gender (optional)" android:textColor="#243040" android:textStyle="bold" android:textSize="13sp" />
        <Spinner android:id="@+id/spinnerGender" android:layout_width="match_parent" android:layout_height="52dp"
            android:spinnerMode="dropdown" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Goal" android:textColor="#243040" android:textStyle="bold" android:textSize="13sp" />
        <Spinner android:id="@+id/spinnerGoal" android:layout_width="match_parent" android:layout_height="52dp"
            android:spinnerMode="dropdown" />
    </LinearLayout>
</ScrollView>