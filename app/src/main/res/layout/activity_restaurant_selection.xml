<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F5">

    <!-- Page Title -->
    <TextView
        android:id="@+id/textRestaurantSelection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="85dp"
        android:layout_marginEnd="85dp"
        android:layout_marginTop="28dp"
        android:text="Restaurants"
        android:textSize="23sp"
        android:textStyle="bold"
        android:textColor="#1C2533"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Cart Button -->
    <TextView
        android:id="@+id/textButtonCart"
        android:layout_width="70dp"
        android:layout_height="45dp"
        android:layout_marginStart="10dp"
        android:background="#F66A2A"
        android:gravity="center"
        android:drawableTop="@drawable/ic_cart"
        android:paddingTop="15dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/textRestaurantSelection"
        app:layout_constraintBottom_toBottomOf="@id/textRestaurantSelection"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Profile Button -->
    <TextView
        android:id="@+id/textButtonProfile"
        android:layout_width="70dp"
        android:layout_height="45dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/mb_primary"
        android:gravity="center"
        android:drawableTop="@drawable/ic_profile"
        android:paddingTop="15dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/textRestaurantSelection"
        app:layout_constraintBottom_toBottomOf="@id/textRestaurantSelection"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Restaurant Information Card -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewRestaurants"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textRestaurantSelection" />

</androidx.constraintlayout.widget.ConstraintLayout>
