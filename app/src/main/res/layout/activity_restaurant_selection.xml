<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F5">

    <!-- Page Title -->
    <TextView
        android:id="@+id/textRestaurantSelection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="85dp"
        android:layout_marginEnd="85dp"
        android:layout_marginTop="28dp"
        android:text="Restaurants"
        android:textSize="23sp"
        android:textStyle="bold"
        android:textColor="#1C2533"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Cart Button -->
    <TextView
        android:id="@+id/textButtonCart"
        android:layout_width="70dp"
        android:layout_height="45dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/mb_primary"
        android:gravity="center"
        android:text="Cart"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/textRestaurantSelection"
        app:layout_constraintBottom_toBottomOf="@id/textRestaurantSelection"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Profile Button -->
    <TextView
        android:id="@+id/textButtonProfile"
        android:layout_width="70dp"
        android:layout_height="45dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/mb_primary"
        android:gravity="center"
        android:text="Profile"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/textRestaurantSelection"
        app:layout_constraintBottom_toBottomOf="@id/textRestaurantSelection"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Restaurant Information Card -->
    <LinearLayout
        android:id="@+id/layoutRestaurantInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="55dp"
        android:background="@drawable/mb_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textRestaurantSelection">

        <!-- Restaurant Image -->
        <ImageView
            android:id="@+id/imageRestaurant"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="18dp"
            android:scaleType="centerCrop"
            android:contentDescription="Restaurant image"
            app:srcCompat="@android:drawable/ic_menu_gallery" />

        <!-- Restaurant Name -->
        <TextView
            android:id="@+id/textRestaurantName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Restaurant Name"
            android:textColor="#1C2533"
            android:textColorHint="#1C2533"
            android:textSize="23sp"
            android:textStyle="bold" />

        <!-- Restaurant Description -->
        <TextView
            android:id="@+id/textRestaurantDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Restaurant Description"
            android:textColor="#697381"
            android:textColorHint="#697381"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <!-- Restaurant Address -->
        <TextView
            android:id="@+id/textRestaurantAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:hint="Restaurant Address"
            android:textColor="#697381"
            android:textColorHint="#697381"
            android:textSize="14sp" />

        <!-- View Menu Button -->
        <TextView
            android:id="@+id/textButtonRestaurantMenu"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/mb_primary"
            android:gravity="center"
            android:text="View Menu"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
