<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="180dp"
    android:layout_height="280dp"
    android:orientation="vertical"
    android:padding="5dp"
    android:background="#FFF9F5">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Food Name -->
            <TextView
                android:id="@+id/foodName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="Chicken Burger"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1C2533"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"/>

            <!-- Food Image -->
            <ImageView
                android:id="@+id/foodImg"
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:layout_marginTop="6dp"
                android:scaleType="centerCrop"
                android:contentDescription="Food image"
                android:src="@drawable/ic_launcher_background"/>

            <!-- Price -->
            <TextView
                android:id="@+id/foodPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="$12.99"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#F66A2A"
                android:gravity="center"/>

            <!-- Calories -->
            <TextView
                android:id="@+id/foodCalories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="450 kcal"
                android:textSize="13sp"
                android:textColor="#697381"
                android:gravity="center"/>

            <!-- Add Button -->
            <Button
                android:id="@+id/foodAddBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#F66A2A"
                android:text="Add +"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:elevation="2dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
